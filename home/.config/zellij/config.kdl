// Zellij config — https://zellij.dev/documentation/
// Symlinked from crrow/dotfiles.

theme "gruvbox-dark"
default_shell "zsh"
default_layout "compact"

mouse_mode true
copy_on_select true
scroll_buffer_size 100000

pane_frames false
simplified_ui true

ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}
